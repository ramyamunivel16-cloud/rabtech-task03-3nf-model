
-- RabTech Task 03: Relational Schema Modeling & 3NF
-- Database: PostgreSQL

CREATE TABLE tenants (
    tenant_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    tenant_name VARCHAR(100) NOT NULL UNIQUE,
    plan VARCHAR(20) NOT NULL DEFAULT 'FREE'
        CHECK (plan IN ('FREE', 'PRO', 'ENTERPRISE'))
);

CREATE TABLE users (
    user_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    tenant_id BIGINT NOT NULL
        REFERENCES tenants(tenant_id) ON DELETE CASCADE,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(255) NOT NULL,
    UNIQUE (tenant_id, email),
    UNIQUE (tenant_id, user_id)
);

CREATE TABLE projects (
    project_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    tenant_id BIGINT NOT NULL
        REFERENCES tenants(tenant_id) ON DELETE CASCADE,
    project_name VARCHAR(150) NOT NULL,
    created_by BIGINT NOT NULL,
    UNIQUE (tenant_id, project_id),
    FOREIGN KEY (tenant_id, created_by)
        REFERENCES users(tenant_id, user_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE roles (
    role_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    role_name VARCHAR(50) NOT NULL UNIQUE,
    description VARCHAR(200)
);

-- Many-to-many: users and projects
CREATE TABLE project_members (
    tenant_id BIGINT NOT NULL,
    project_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    joined_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (tenant_id, project_id, user_id),
    FOREIGN KEY (tenant_id, project_id)
        REFERENCES projects(tenant_id, project_id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY (tenant_id, user_id)
        REFERENCES users(tenant_id, user_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

-- Many-to-many: users and roles
CREATE TABLE user_roles (
    tenant_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    role_id BIGINT NOT NULL REFERENCES roles(role_id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    PRIMARY KEY (tenant_id, user_id, role_id),
    FOREIGN KEY (tenant_id, user_id)
        REFERENCES users(tenant_id, user_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

-- One-to-one: each project has at most one settings row
CREATE TABLE project_settings (
    tenant_id BIGINT NOT NULL,
    project_id BIGINT NOT NULL,
    timezone VARCHAR(60) NOT NULL DEFAULT 'UTC',
    visibility VARCHAR(20) NOT NULL DEFAULT 'PRIVATE'
        CHECK (visibility IN ('PRIVATE', 'PUBLIC')),
    PRIMARY KEY (tenant_id, project_id),
    FOREIGN KEY (tenant_id, project_id)
        REFERENCES projects(tenant_id, project_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE tasks (
    task_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    tenant_id BIGINT NOT NULL,
    project_id BIGINT NOT NULL,
    title VARCHAR(200) NOT NULL,
    task_status VARCHAR(20) NOT NULL DEFAULT 'TODO'
        CHECK (task_status IN ('TODO', 'IN_PROGRESS', 'DONE')),
    due_date DATE,
    UNIQUE (tenant_id, task_id),
    FOREIGN KEY (tenant_id, project_id)
        REFERENCES projects(tenant_id, project_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

-- Useful lookup indexes
CREATE INDEX idx_users_tenant ON users(tenant_id);
CREATE INDEX idx_projects_tenant ON projects(tenant_id);
CREATE INDEX idx_tasks_project ON tasks(tenant_id, project_id);
